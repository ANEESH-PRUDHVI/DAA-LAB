#include <stdio.h>
#define INF 999

int main(){
    int n=4,e=4;
    int u[]={0,0,1,2};
    int v[]={1,2,2,3};
    int w[]={1,4,2,3};

    int dist[4];
    for(int i=0;i<n;i++) dist[i]=INF;
    dist[0]=0;

    for(int i=0;i<n-1;i++)
        for(int j=0;j<e;j++)
            if(dist[u[j]]+w[j]<dist[v[j]])
                dist[v[j]]=dist[u[j]]+w[j];

    for(int i=0;i<n;i++)
        printf("%d ",dist[i]);
}
