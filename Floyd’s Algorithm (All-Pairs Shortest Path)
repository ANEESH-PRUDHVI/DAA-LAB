#include <stdio.h>
#define INF 999

int main(){
    int d[3][3]={{0,3,INF},{2,0,INF},{INF,7,0}};
    int n=3;

    for(int k=0;k<n;k++)
        for(int i=0;i<n;i++)
            for(int j=0;j<n;j++)
                if(d[i][k]+d[k][j]<d[i][j])
                    d[i][j]=d[i][k]+d[k][j];

    for(int i=0;i<n;i++){
        for(int j=0;j<n;j++)
            printf("%d ",d[i][j]);
        printf("\n");
    }
}
