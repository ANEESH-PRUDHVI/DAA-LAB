#include <stdio.h>

int main(){
    int a[3][3]={{0,1,0},{0,0,1},{1,0,0}};
    int n=3;

    for(int k=0;k<n;k++)
        for(int i=0;i<n;i++)
            for(int j=0;j<n;j++)
                a[i][j]=a[i][j]||(a[i][k]&&a[k][j]);

    for(int i=0;i<n;i++){
        for(int j=0;j<n;j++)
            printf("%d ",a[i][j]);
        printf("\n");
    }
}
