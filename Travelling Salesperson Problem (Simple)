#include <stdio.h>
#define INF 999

int n=4, min=INF;
int g[4][4]={{0,10,15,20},{10,0,35,25},{15,35,0,30},{20,25,30,0}};

void tsp(int v[],int curr,int count,int cost){
    if(count==n && g[curr][0]){
        if(cost+g[curr][0]<min)
            min=cost+g[curr][0];
        return;
    }

    for(int i=0;i<n;i++){
        if(!v[i] && g[curr][i]){
            v[i]=1;
            tsp(v,i,count+1,cost+g[curr][i]);
            v[i]=0;
        }
    }
}

int main(){
    int v[4]={0};
    v[0]=1;
    tsp(v,0,1,0);
    printf("Min cost=%d",min);
}
