#include <stdio.h>

int max(int a,int b){ return a>b?a:b; }

int main(){
    int wt[]={1,2,3}, val[]={10,15,40};
    int W=6,n=3;
    int dp[10][10];

    for(int i=0;i<=n;i++){
        for(int w=0;w<=W;w++){
            if(i==0||w==0) dp[i][w]=0;
            else if(wt[i-1]<=w)
                dp[i][w]=max(val[i-1]+dp[i-1][w-wt[i-1]],dp[i-1][w]);
            else
                dp[i][w]=dp[i-1][w];
        }
    }

    printf("Max value=%d",dp[n][W]);
}
