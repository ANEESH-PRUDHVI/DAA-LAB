#include <stdio.h>

int main(){
    int g[3][3]={{0,1,1},{1,0,1},{1,1,0}};
    int q[10],front=0,rear=0,visited[3]={0};

    q[rear++]=0;
    visited[0]=1;

    while(front<rear){
        int i=q[front++];
        printf("%d ",i);

        for(int j=0;j<3;j++){
            if(g[i][j] && !visited[j]){
                q[rear++]=j;
                visited[j]=1;
            }
        }
    }
}
